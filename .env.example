# Copy this file to .env and paste the API key created in the Console
# organization that holds your Build Day credits.
# Values in .env override any ANTHROPIC_API_KEY set elsewhere on this machine.
ANTHROPIC_API_KEY=

# Only needed if the key is organization-level (not created inside a workspace):
# the workspace to bill, from Console -> Settings -> Workspaces.
ANTHROPIC_WORKSPACE_ID=
